/*
 * Minimal smoke test profile.
 *
 * Uses the synthetic fixtures in tests/, NOT GSE174609 -- the real dataset needs
 * an ~11 GB reference and far more RAM than a laptop has. Build a fixture first:
 *
 *   tests/make_fixture.sh    <dir>   # stage counts
 *   tests/make_qc_fixture.sh <dir>   # stage qc
 *
 * then point --input / --counts_dir at it. See docs/testing.md.
 */
params {
    max_cpus     = 4
    max_memory   = '6.GB'
    max_time     = '2.h'

    // stage counts: the open quantifier is the only one runnable on a laptop
    quantifier   = 'kallisto'

    // stage qc: keep the stochastic steps cheap and deterministic
    seed                 = 42
    emptydrops_niters    = 1000     // 10000 in production; Monte Carlo, so slow
    silhouette_subsample = 2000

    // SoupX's soupQuantile gate is unreachable from a ~1300-gene synthetic
    // fixture: a marker of an abundant cell type is genuinely high in the soup
    // of real 30k-gene data, but cannot be in a fixture this small. A joint
    // parameter sweep left soup/q90 pinned at 0.98-0.99 across every lever.
    // Lowered HERE ONLY -- production keeps SoupX's default 0.90.
    soupx_soup_quantile  = 0.50
}
