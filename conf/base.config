/*
 * Resource requests by label. Retries escalate memory, because the usual
 * failure mode for a quantifier is OOM, not a logic error.
 */
process {
    container   = params.container_image
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries  = 2

    cpus   = 1
    memory = { 4.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    withLabel: process_low    { cpus = 2; memory = { 4.GB  * task.attempt } }
    withLabel: process_medium { cpus = 4; memory = { 8.GB  * task.attempt } }
    withLabel: process_high   { cpus = 8; memory = { 14.GB * task.attempt } }

    // Full genome alignment against human needs far more than a laptop has.
    // On slurm this is honoured; locally it will refuse to run, by design.
    withName: CELLRANGER_COUNT {
        label  = 'process_high'
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        containerOptions = { "-v ${params.cellranger_path}:/opt/cellranger:ro" }
    }
}
