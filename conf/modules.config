/*
 * Per-process publishing and CLI arguments.
 * ext.args is the single place tool flags are set -- never hardcoded in modules.
 */
process {
    publishDir = [
        path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:    'copy',
        saveAs:  { fn -> fn.equals('versions.yml') ? null : fn }
    ]

    withName: SRATOOLS_FASTERQDUMP {
        // --include-technical is essential: SRA flags the barcode read as
        // technical, and without this you silently get R2 only.
        ext.args = '--split-files --include-technical'
    }

    withName: TENX_READ_DETECT {
        publishDir = [ path: { "${params.outdir}/read_detection" }, mode: 'copy',
                       pattern: '*.readinfo.json' ]
    }

    withName: CELLRANGER_COUNT {
        ext.args = '--create-bam=false'
    }

    // ---- stage: qc ----
    withName: 'EMPTYDROPS|SUBSET_CELLS' {
        publishDir = [ path: { "${params.outdir}/qc/emptydrops" }, mode: 'copy',
                       pattern: '*.{csv,json}' ]
    }
    withName: 'AMBIENT_SOUPX' {
        publishDir = [ path: { "${params.outdir}/qc/ambient" }, mode: 'copy', pattern: '*.json' ]
    }
    withName: 'DOUBLETS_.*' {
        publishDir = [ path: { "${params.outdir}/qc/doublets" }, mode: 'copy', pattern: '*.csv' ]
    }
    withName: 'CELL_QC' {
        publishDir = [ path: { "${params.outdir}/qc/cell_qc" }, mode: 'copy',
                       pattern: '*.{json,h5ad}' ]
    }
    withName: 'MERGE_SAMPLES|NORMALIZE_HVG|INTEGRATE|INTEGRATION_QC' {
        publishDir = [ path: { "${params.outdir}/qc/integrated" }, mode: 'copy',
                       pattern: '*.{h5ad,json}' ]
    }

    withName: COUNTS_TO_H5AD {
        publishDir = [ path: { "${params.outdir}/h5ad" }, mode: 'copy', pattern: '*.h5ad' ]
    }
}
