/*
 * myRNASeqPipeline -- single-cell RNA-seq
 * Lecture 1 scope: raw reads -> count matrices -> standardised .h5ad
 */

manifest {
    name            = 'myRNASeqPipeline'
    author          = 'Parsa Ghadermarzi'
    description     = 'Comprehensive single-cell RNA-seq pipeline'
    version         = '0.2.0'
    nextflowVersion = '>=24.04.0'
    mainScript      = 'main.nf'
}

params {
    // --- input / output ---
    input             = null           // samplesheet CSV (see assets/schema_input.json)
    outdir            = 'results'
    // Stages are run one at a time; each finds the previous stage's output.
    stage             = 'counts'       // counts | qc | annotate | de
    step              = 'fastq'        // within 'counts': 'fastq' | 'counts'

    // --- quantifier (swappable interface; all emit the same channel shape) ---
    quantifier        = 'cellranger'   // cellranger | alevinfry | kallisto

    // cellranger is licensed and never containerised: point at your unpacked
    // tarball and it is bind-mounted read-only into the pipeline image.
    cellranger_path   = null
    cellranger_ref    = null           // refdata-gex-* directory

    // open quantifiers build their own index from genome + GTF
    genome_fasta      = null
    gtf               = null

    // --- index building (used only when no index is supplied) ---
    // Indexes are expensive and reusable, so they are cached here with
    // storeDir rather than rebuilt per run. Point this at an external drive if
    // your internal disk is tight -- a human cellranger package is ~11 GB.
    index_cache       = "${launchDir}/references"
    reference_id      = null        // default: derived from the fasta + gtf names

    // cellranger mkgtf biotypes. Filtering is NOT cosmetic: a read overlapping
    // two annotated features is dropped as ambiguous, so leaving pseudogenes in
    // silently deletes counts from the real genes they resemble.
    gtf_biotypes      = 'protein_coding,lncRNA,IG_C_gene,IG_D_gene,IG_J_gene,IG_LV_gene,IG_V_gene,TR_C_gene,TR_D_gene,TR_J_gene,TR_V_gene'

    // splici by default: keeps spliced/unspliced separable, which is the whole
    // basis of RNA velocity. A spliced-only index forecloses Part 13 (scVelo).
    af_ref_type       = 'spliced+intronic'
    read_length       = 91          // R2 length; sets splici intronic flank size
    kb_workflow       = 'standard'  // 'nac' = kb's velocity-capable equivalent
    // prebuilt index, skips index building.
    //   alevinfry: simpleaf's OUTPUT dir (contains index/ and ref/)
    //   kallisto : dir containing index.idx and t2g.txt
    index             = null

    // --- chemistry ---
    // null = auto-detect from R1 length (26bp -> SC3Pv2, 28bp -> SC3Pv3).
    // Setting this overrides detection; a mismatch is a hard error, not a warning.
    chemistry         = null
    expect_cells      = null

    // ===================== stage: qc  (Parts 2, 2-2, 3) =====================
    counts_dir            = null       // defaults to <outdir>/h5ad
    emptydrops_skip       = false      // Cell Ranger already applies a similar call

    seed                  = 42         // emptyDrops/scDblFinder are stochastic

    // -- empty droplets --
    emptydrops_lower      = 100        // barcodes below this DEFINE the ambient profile
    emptydrops_niters     = 10000      // Monte Carlo iterations
    emptydrops_fdr        = 0.01

    // -- preliminary clustering (throwaway; only to label cells for SoupX) --
    prelim_resolution     = 0.8
    n_pcs                 = 30
    n_hvg                 = 2000

    // -- ambient RNA --
    ambient_method        = 'soupx'    // soupx | decontx | cellbender | none
    soupx_min_rho         = 0.05       // tutorial: correct only if contamination >= 5%
    soupx_rho             = null       // override autoEstCont entirely
    soupx_tfidf_min       = 1.0        // lower if autoEstCont finds no markers
    soupx_soup_quantile   = 0.90       // lower for low-complexity channels

    // -- doublets: a list is allowed here because each method emits only a CSV,
    //    unlike ambient correction which rewrites the whole matrix --
    doublet_method        = 'scdblfinder'  // scdblfinder | doubletfinder | scrublet | doubletdetection
    doublet_removal       = 'primary'      // primary | consensus | none
    doublet_rate          = null           // null => estimated (~0.8% per 1000 cells)

    // -- cell / gene QC --
    qc_method             = 'mad'      // mad (generalises) | fixed (reproduces tutorial)
    mad_nmads             = 3
    min_genes             = 500        // 'fixed' mode only
    max_genes             = 5000
    min_counts            = 800
    max_counts            = 20000
    max_mito_pct          = 20         // absolute ceiling, ALWAYS applied
    min_cells_per_gene    = 3
    remove_hb_genes       = true       // set false for bone marrow / erythropoiesis

    // -- normalisation + HVG --
    norm_method           = 'lognorm'  // lognorm | pearson_residuals
    n_pcs_merged          = 50

    // -- integration --
    integration_method    = 'harmony'  // harmony | scanorama | none | (cca|rpca|fastmnn = R module)
    batch_key             = 'sample'   // technical grouping, NOT condition
    condition_key         = 'condition'
    mixing_k              = 50
    silhouette_subsample  = 5000       // silhouette is O(n^2)

    // --- QC gating ---
    // alevin-fry's EM UMI resolution emits FRACTIONAL counts; downstream tools
    // (DESeq2, scDblFinder) assume integers. Policy is explicit and recorded.
    fractional_counts_policy    = 'round'   // round | floor | keep
    min_valid_barcode_fraction  = 0.70      // below this = likely wrong chemistry
    qc_strict                   = true      // fail the run, don't just warn

    // --- toggles ---
    skip_fastqc       = false
    skip_multiqc      = false

    // Image name lives here only. Change once when publishing under a
    // different Docker Hub namespace.
    container_image   = 'parsaghadermazi/myrnaseqpipeline:0.2.0'

    // --- resources ---
    max_cpus          = 8
    max_memory        = '14.GB'
    max_time          = '48.h'
}

profiles {
    docker {
        docker.enabled  = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    conda { conda.enabled = true }

    // architecture selectors -- cellranger requires amd64
    arm { docker.runOptions = '--platform linux/arm64 -u $(id -u):$(id -g)' }
    amd { docker.runOptions = '--platform linux/amd64 -u $(id -u):$(id -g)' }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }
    test { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// --- provenance: always on ---
def ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${ts}.html"   }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${ts}.txt"     }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${ts}.html"      }
